# Variables de PRODUCCIÓN. Cópialo a `.env.prod` (que NO se sube a git) y rellénalo:
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f infra/docker-compose.prod.yml up -d --build
#
# Los valores marcados con «openssl rand» se generan así; nunca uses los de ejemplo.

# ---- Base de datos ----
# `db` levanta PostgreSQL en un contenedor (lo más simple, con el volumen postgres-data). Con una base gestionada
# (Amazon RDS) deja esto vacío y define DB_URL abajo.
COMPOSE_PROFILES=db
DB_NAME=diagramas
DB_USER=diagramas
# openssl rand -base64 24
DB_PASSWORD=
# Solo con RDS: jdbc:postgresql://<endpoint>:5432/diagramas
# DB_URL=

# ---- Seguridad ----
# openssl rand -base64 48   (mínimo 32 caracteres)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Contraseña del administrador de la plataforma (usuario `admin`, empresa `platform`). Mínimo 12 caracteres.
SEED_ADMIN_PASSWORD=
# Origen público de la aplicación, tal como lo escribe el usuario en el navegador.
CORS_ALLOWED_ORIGINS=https://diagramas.ejemplo.com

# ---- Colaboración en tiempo real (red interna de Docker) ----
# openssl rand -base64 24
REDIS_PASSWORD=
RABBIT_USER=diagramas
# openssl rand -base64 24
RABBIT_PASSWORD=

# ---- Asistente de IA ----
# openssl rand -base64 32   (clave entre el backend y el ai-service)
AI_INTERNAL_KEY=
AI_TIMEOUT_SECONDS=30
# «openai» = protocolo compatible con OpenAI (sirve para Gemini)
LLM_PROVIDER=openai
# clave del proveedor
LLM_API_KEY=
# p. ej. gemini-flash-lite-latest
LLM_MODEL=
# p. ej. https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=25

# ---- Archivos (AWS S3) ----
# Bucket privado donde se guardan los XMI exportados. Vacío = se guardan en un volumen de Docker.
S3_BUCKET=
AWS_REGION=us-east-1
# Las credenciales salen del ROL de IAM de la instancia (recomendado). Solo si no usas un rol:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Notificaciones push (Firebase) ----
# La clave de la cuenta de servicio, COMPLETA y en UNA sola línea, en base64. Se genera así:
#   Linux/macOS:  base64 -w0 firebase-key.json
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-key.json"))
# Vacío = las notificaciones solo se guardan en la base de datos, sin push.
FCM_CREDENTIALS_JSON=

# Configuración PÚBLICA de Firebase para el push de la web (no son secretos; Vite las incorpora al compilar).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ---- Red ----
HTTP_PORT=80
# Solo con docker-compose.tls.yml (HTTPS con Let's Encrypt):
# TLS_DOMAIN=diagramas.ejemplo.com
# HTTPS_PORT=443
